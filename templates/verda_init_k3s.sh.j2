#!/bin/bash

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export HOME=/root/

K8S_ENDPOINT="{{ k8s_endpoint }}"
K8S_TOKEN="{{ k8s_token }}"

# Injected Labels
LABELS="{{ labels }}"

WG_IP="{{ wg_tunnel_ip }}"
WG_PRIVATE_KEY="{{ wg_private_key }}"
WG_LISTEN_PORT="{{ wg_listen_port }}"
PEER_PUBKEY="{{ wg_peer_pubkey }}"
ALLOWED_IPS="{{ wg_allowed_ips }}"

# for testing purposes
echo "10.200.0.1 control01.k3s.aalto.fi" >> /etc/hosts

# Get instance ID from Verda metadata service
INSTANCE_ID="$(cat /var/lib/cloud/data/instance-id 2>/dev/null || true)"

# ---------------------------------------------------------------------------
# System update
# ---------------------------------------------------------------------------
apt-get update
apt-get upgrade -y

# ---------------------------------------------------------------------------
# WireGuard
# ---------------------------------------------------------------------------
apt-get install -y ca-certificates curl gpg wireguard-tools

install -m 0600 /dev/null /etc/wireguard/wg0.conf
cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
Address = ${WG_IP}/24
ListenPort = ${WG_LISTEN_PORT}
PrivateKey = ${WG_PRIVATE_KEY}

[Peer]
PublicKey = ${PEER_PUBKEY}
AllowedIPs = ${ALLOWED_IPS}
EOF

systemctl enable --now wg-quick@wg0

# ---------------------------------------------------------------------------
# Kernel modules + sysctl for Kubernetes networking
# ---------------------------------------------------------------------------
cat <<'EOF' >/etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOF

modprobe overlay
modprobe br_netfilter

cat <<'EOF' >/etc/sysctl.d/99-kubernetes-cri.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF

sysctl --system

# ---------------------------------------------------------------------------
# containerd (external install — required for NVIDIA; k3s will be pointed
# at it when nvidia-ctk is present, otherwise k3s uses its bundled runtime)
# ---------------------------------------------------------------------------
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
  | gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg
chmod 0644 /etc/apt/keyrings/docker.gpg

echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
  https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  | tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update
apt-get install -y containerd.io

mkdir -p /etc/containerd
containerd config default > /etc/containerd/config.toml

sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
sed -i -E 's/^disabled_plugins *= *\["cri"\]/#&/'     /etc/containerd/config.toml

if command -v nvidia-ctk &>/dev/null; then
    nvidia-ctk runtime configure --runtime=containerd --set-as-default
fi

systemctl enable --now containerd
systemctl restart containerd

# ---------------------------------------------------------------------------
# k3s agent
# ---------------------------------------------------------------------------
EXTRA_AGENT_ARGS="--node-ip ${WG_IP} \
    --kubelet-arg=provider-id=verda://${INSTANCE_ID}"

# Pass node labels if provided (comma-separated key=value pairs)
if [ -n "${LABELS}" ]; then
    EXTRA_AGENT_ARGS="${EXTRA_AGENT_ARGS} --node-label=${LABELS}"
fi

# Use external containerd socket only when NVIDIA runtime was configured;
# otherwise k3s uses its own bundled containerd at /run/k3s/containerd/containerd.sock
if command -v nvidia-ctk &>/dev/null; then
    EXTRA_AGENT_ARGS="${EXTRA_AGENT_ARGS} \
        --container-runtime-endpoint unix:///run/containerd/containerd.sock"
fi

if [ ! -f /var/lib/rancher/k3s/agent/kubelet.kubeconfig ]; then
    echo "Joining k3s cluster..."
    curl -sfL https://get.k3s.io \
      | INSTALL_K3S_CHANNEL="v1.30" \
        K3S_URL="https://${K8S_ENDPOINT}" \
        K3S_TOKEN="${K8S_TOKEN}" \
        INSTALL_K3S_EXEC="agent ${EXTRA_AGENT_ARGS}" \
        sh -
    echo "Successfully joined cluster!"
else
    echo "Node already joined to cluster"
fi
