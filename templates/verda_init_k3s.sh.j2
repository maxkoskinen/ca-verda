#!/bin/bash

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export HOME=/root/

K8S_ENDPOINT="{{ k8s_endpoint }}"
K8S_TOKEN="{{ k8s_token }}"

# Injected Labels
LABELS="{{ labels }}"
NODE_TAINTS="{{ taints }}"

WG_IP="{{ wg_tunnel_ip }}"
WG_PRIVATE_KEY="{{ wg_private_key }}"
WG_LISTEN_PORT="{{ wg_listen_port }}"
PEER_PUBKEY="{{ wg_peer_pubkey }}"
ALLOWED_IPS="{{ wg_allowed_ips }}"

# for testing purposes
echo "10.200.0.1 control01.k3s.aalto.fi" >> /etc/hosts

# Get instance ID from Verda metadata service
INSTANCE_ID="$(cat /var/lib/cloud/data/instance-id 2>/dev/null || true)"

# ---------------------------------------------------------------------------
# System update
# ---------------------------------------------------------------------------
apt-get update
apt-get upgrade -y

# ---------------------------------------------------------------------------
# WireGuard
# ---------------------------------------------------------------------------
apt-get install -y ca-certificates curl gpg wireguard-tools

install -m 0600 /dev/null /etc/wireguard/wg0.conf
cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
Address = ${WG_IP}/24
ListenPort = ${WG_LISTEN_PORT}
PrivateKey = ${WG_PRIVATE_KEY}

[Peer]
PublicKey = ${PEER_PUBKEY}
AllowedIPs = ${ALLOWED_IPS}
EOF

systemctl enable --now wg-quick@wg0

# ---------------------------------------------------------------------------
# Kernel modules + sysctl for Kubernetes networking
# ---------------------------------------------------------------------------
cat <<'EOF' >/etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOF

modprobe overlay
modprobe br_netfilter

cat <<'EOF' >/etc/sysctl.d/99-kubernetes-cri.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF

sysctl --system

# ---------------------------------------------------------------------------
# k3s agent
# k3s uses its own bundled containerd — no external containerd needed.
# NVIDIA runtime is auto-detected by k3s from the CUDA image.
# ---------------------------------------------------------------------------
EXTRA_AGENT_ARGS="--node-ip ${WG_IP} \
    --flannel-iface=wg0 \
    --kubelet-arg=provider-id=verda://${INSTANCE_ID}"

# inject labels
if [ -n "${LABELS}" ]; then
    IFS=',' read -ra _LABEL_ARR <<< "${LABELS}"
    for _label in "${_LABEL_ARR[@]}"; do
        EXTRA_AGENT_ARGS="${EXTRA_AGENT_ARGS} --node-label=${_label}"
    done
fi

# Inject taints
if [ -n "${NODE_TAINTS}" ]; then
    IFS=',' read -ra _TAINT_ARR <<< "${NODE_TAINTS}"
    for _taint in "${_TAINT_ARR[@]}"; do
        EXTRA_AGENT_ARGS="${EXTRA_AGENT_ARGS} --node-taint=${_taint}"
    done
fi

if [ ! -f /var/lib/rancher/k3s/agent/kubelet.kubeconfig ]; then
    echo "Joining k3s cluster..."
    curl -sfL https://get.k3s.io \
      | INSTALL_K3S_VERSION="v1.32.3+k3s1" \
        K3S_URL="https://${K8S_ENDPOINT}" \
        K3S_TOKEN="${K8S_TOKEN}" \
        INSTALL_K3S_EXEC="agent ${EXTRA_AGENT_ARGS}" \
        sh -
    echo "Successfully joined cluster!"
else
    echo "Node already joined to cluster"
fi

# ---------------------------------------------------------------------------
# NVIDIA — configure k3s's bundled containerd post-install (GPU nodes only)
# ---------------------------------------------------------------------------
if command -v nvidia-smi &>/dev/null && nvidia-smi -L 2>/dev/null | grep -q GPU; then
    echo "GPU detected, configuring nvidia runtime..."
    until [ -d /var/lib/rancher/k3s/agent/etc/containerd ]; do
        echo "Waiting for k3s containerd config dir..."
        sleep 2
    done
    nvidia-ctk runtime configure \
        --runtime=containerd \
        --config /var/lib/rancher/k3s/agent/etc/containerd/config.toml \
        --set-as-default
    systemctl restart k3s-agent
    echo "NVIDIA runtime configured."
fi
