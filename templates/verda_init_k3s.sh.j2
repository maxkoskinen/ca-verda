#    sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
#    sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list
#
#apt-get update
#
#export NVIDIA_CONTAINER_TOOLKIT_VERSION=1.19.0-1
#  sudo apt-get install -y \
#      nvidia-container-toolkit=${NVIDIA_CONTAINER_TOOLKIT_VERSION} \
#      nvidia-container-toolkit-base=${NVIDIA_CONTAINER_TOOLKIT_VERSION} \
#      libnvidia-container-tools=${NVIDIA_CONTAINER_TOOLKIT_VERSION} \
#      libnvidia-container1=${NVIDIA_CONTAINER_TOOLKIT_VERSION}
#
#apt install -y nvidia-container-runtime cuda-drivers-fabricmanager-515 nvidia-headless-515-server

GPU_RUNTIME_ARG=""
if command -v nvidia-smi &>/dev/null && nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | grep -q .; then
    echo "GPU detected — will set nvidia as default runtime"
    GPU_RUNTIME_ARG="--default-runtime=nvidia"
fi

# ---------------------------------------------------------------------------
# k3s agent
# k3s uses its own bundled containerd — no external containerd needed.
# NVIDIA runtime is auto-detected by k3s from the CUDA image.
# ---------------------------------------------------------------------------
EXTRA_AGENT_ARGS="--node-ip ${WG_IP} \
    --flannel-iface=wg0 \
    --kubelet-arg=provider-id=verda://${INSTANCE_ID} \
    ${GPU_RUNTIME_ARG}"

# inject labels
if [ -n "${LABELS}" ]; then
    IFS=',' read -ra _LABEL_ARR <<< "${LABELS}"
    for _label in "${_LABEL_ARR[@]}"; do
        EXTRA_AGENT_ARGS="${EXTRA_AGENT_ARGS} --node-label=${_label}"
    done
fi

# Inject taints
if [ -n "${NODE_TAINTS}" ]; then
    IFS=',' read -ra _TAINT_ARR <<< "${NODE_TAINTS}"
    for _taint in "${_TAINT_ARR[@]}"; do
        EXTRA_AGENT_ARGS="${EXTRA_AGENT_ARGS} --node-taint=${_taint}"
    done
fi

if [ ! -f /var/lib/rancher/k3s/agent/kubelet.kubeconfig ]; then
    echo "Joining k3s cluster..."
    curl -sfL https://get.k3s.io \
      | INSTALL_K3S_VERSION="v1.32.3+k3s1" \
        K3S_URL="https://${K8S_ENDPOINT}" \
        K3S_TOKEN="${K8S_TOKEN}" \
        INSTALL_K3S_EXEC="agent ${EXTRA_AGENT_ARGS}" \
        sh -
    echo "Successfully joined cluster!"
else
    echo "Node already joined to cluster"
fi

