#!/bin/bash

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export HOME=/root/

K8S_ENDPOINT="{{ k8s_endpoint }}"
K8S_TOKEN="{{ k8s_token }}"

# Injected Labels
LABELS="{{ labels }}"
NODE_TAINTS="{{ taints }}"

WG_IP="{{ wg_tunnel_ip }}"
WG_PRIVATE_KEY="{{ wg_private_key }}"
WG_LISTEN_PORT="{{ wg_listen_port }}"
PEER_PUBKEY="{{ wg_peer_pubkey }}"
ALLOWED_IPS="{{ wg_allowed_ips }}"

# for testing purposes
echo "10.200.0.1 control01.k3s.aalto.fi" >> /etc/hosts

# Get instance ID from Verda metadata service
INSTANCE_ID="$(cat /var/lib/cloud/data/instance-id 2>/dev/null || true)"

# ---------------------------------------------------------------------------
# System update
# ---------------------------------------------------------------------------
apt-get update
#apt-mark hold $(dpkg -l | awk '/^ii.*nvidia/{print $2}' | tr '\n' ' ') 2>/dev/null || true
#apt-get upgrade -y

# ---------------------------------------------------------------------------
# WireGuard
# ---------------------------------------------------------------------------
apt-get install -y ca-certificates curl gpg wireguard-tools

install -m 0600 /dev/null /etc/wireguard/wg0.conf
cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
Address = ${WG_IP}/24
ListenPort = ${WG_LISTEN_PORT}
PrivateKey = ${WG_PRIVATE_KEY}

[Peer]
PublicKey = ${PEER_PUBKEY}
AllowedIPs = ${ALLOWED_IPS}
EOF

systemctl enable --now wg-quick@wg0

# ---------------------------------------------------------------------------
# Kernel modules + sysctl for Kubernetes networking
# ---------------------------------------------------------------------------
cat <<'EOF' >/etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOF

modprobe overlay
modprobe br_netfilter

cat <<'EOF' >/etc/sysctl.d/99-kubernetes-cri.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF

sysctl --system


# NVIDIA stuff
#apt-get install -y --no-install-recommends gnupg2
#
#curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | sudo gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg \
